# Copy this file to .env and fill in your keys.  (.env is git-ignored — never commit real keys.)
OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...

# Optional
# MEMORY_EMBEDDINGS=local     # use a free offline embedding model instead of OpenAI embeddings
# MEMORY_DIR=./chroma_data    # where long-term memory is stored
